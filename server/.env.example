PORT=5000
MONGO_URI=mongodb://localhost:27017/quiz_app
JWT_SECRET=your_super_secret_jwt_key_change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Google OAuth 2.0 (optional — see README for setup) ───────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email / SMTP (for forgot-password emails) ────────────────────────────────
# Leave ALL of these blank in development — the app will use a free Ethereal
# test account and print the email preview URL to the console automatically.
#
# For production, fill these in (example uses Gmail with App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your_16_char_app_password
#   SMTP_FROM="Master Quiz" <youraddress@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── First admin account (used ONLY by: npm run seed:admin) ───────────────────
# These values are NEVER used at runtime — only during the one-time seed.
# Do NOT commit real credentials. Generate a strong password before running seed.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
